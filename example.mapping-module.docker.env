MAPPING_PORT=3001

## Connection to ingestro/importer service
MAPPING_BE_URL=http://importer-module:3000/sdk

# =====================================================
# BACKEND LICENSE KEY
# =====================================================
MAPPING_LICENSE_KEY= #If you decide to keep your license key on the BE side, then you can use this otherwise keep it empty


# =====================================================
# LLM CONFIGURATION
# =====================================================
# Required: Select LLM provider
# Options: AZURE_OPENAI, AZURE_FOUNDRY, AWS_BEDROCK, GCP_VERTEX, OPENAI, ANTHROPIC, MISTRAL
MAPPING_LLM_PROVIDER=

# ---- Azure OpenAI Configuration ----
MAPPING_AZURE_OPENAI_ENDPOINT=
MAPPING_AZURE_OPENAI_DEPLOYMENT_NAME=
MAPPING_AZURE_OPENAI_API_VERSION=
MAPPING_AZURE_OPENAI_API_KEY=

# ---- Azure AI Foundry Configuration ----
MAPPING_AZURE_FOUNDRY_ENDPOINT=
MAPPING_AZURE_FOUNDRY_API_KEY=
MAPPING_AZURE_FOUNDRY_MODEL=

# ---- AWS Bedrock Configuration ----
MAPPING_AWS_BEDROCK_MODEL_ID=
MAPPING_AWS_BEDROCK_REGION=
MAPPING_AWS_BEDROCK_ACCESS_KEY_ID= # Optional: remove or leave empty to use IAM role auth
MAPPING_AWS_BEDROCK_SECRET_ACCESS_KEY= # Optional: remove or leave empty to use IAM role auth

# ---- GCP Vertex Configuration ----
MAPPING_GCP_VERTEX_CREDENTIALS_JSON= # NOTE: Please copy the service account json object here within single quotation marks
MAPPING_GCP_VERTEX_PROJECT_ID=
MAPPING_GCP_VERTEX_LOCATION=
MAPPING_GCP_VERTEX_MODEL_ID=

# ---- Anthropic Configuration ----
MAPPING_ANTHROPIC_API_KEY=
MAPPING_ANTHROPIC_MODEL=

# ---- Mistral Configuration ----
MAPPING_MISTRAL_API_KEY=
MAPPING_MISTRAL_MODEL=

# ---- OpenAI Configuration ----
MAPPING_OPENAI_API_KEY=
MAPPING_OPENAI_MODEL=

# ---- Model Parameters ----
MAPPING_LLM_TEMPERATURE=
