SERVICE_PORT=3002

## Connection to ingestro/importer  service
SERVICE_BE_URL=http://importer-module:3000

# =====================================================
# BACKEND LICENSE KEY
# =====================================================
SERVICE_LICENSE_KEY= # NOTE: If you decide to keep your license key on the BE side, then you can use this otherwise keep it empty

# =====================================================
# LLM PROVIDER REFERENCE (all 3 services use the same pattern)
# =====================================================
# Each service has its own prefix: CONTEXTUAL_ENGINE, CLEANING_ASSISTANT, TEXT_TO_JS
#
# {PREFIX}_LLM_PROVIDER options:
#   AZURE_OPENAI  — customer Azure OpenAI deployment (GPT-4o, GPT-4.1, …)
#   AZURE_FOUNDRY — customer Azure AI Foundry deployment (DeepSeek, Kimi, GLM, Mistral, Claude, …)
#   OPENAI        — direct OpenAI API key (GPT-4o, GPT-4.1, …)
#   AWS_BEDROCK   — customer Bedrock model ID (Claude, …)
#   GCP_VERTEX    — customer Vertex model ID (Claude, Gemini, Mistral/Codestral)
#   ANTHROPIC     — direct Anthropic API key (Claude Haiku, Sonnet, Opus, …)
#   MISTRAL       — direct Mistral API key (Mistral Small, Large, …)
#
# Backwards compatible: AZURE → AZURE_OPENAI, BEDROCK → AWS_BEDROCK
# Model/deployment IDs are required (no runtime defaults).

# =====================================================
# CONTEXTUAL ENGINE LLM CONFIGURATION
# =====================================================
CONTEXTUAL_ENGINE_LLM_PROVIDER=

# ---- Azure OpenAI (AZURE_OPENAI) ----
CONTEXTUAL_ENGINE_AZURE_OPENAI_API_KEY=
CONTEXTUAL_ENGINE_AZURE_OPENAI_ENDPOINT=
CONTEXTUAL_ENGINE_AZURE_OPENAI_API_VERSION=
CONTEXTUAL_ENGINE_AZURE_OPENAI_DEPLOYMENT_NAME=

# ---- Azure AI Foundry (AZURE_FOUNDRY) ----
# CONTEXTUAL_ENGINE_AZURE_FOUNDRY_ENDPOINT=
# CONTEXTUAL_ENGINE_AZURE_FOUNDRY_MODEL=
# CONTEXTUAL_ENGINE_AZURE_FOUNDRY_API_KEY=

# ---- OpenAI (OPENAI) ----
# CONTEXTUAL_ENGINE_OPENAI_API_KEY=
# CONTEXTUAL_ENGINE_OPENAI_MODEL=

# ---- AWS Bedrock (AWS_BEDROCK) ----
CONTEXTUAL_ENGINE_AWS_BEDROCK_MODEL_ID=
CONTEXTUAL_ENGINE_AWS_BEDROCK_ACCESS_KEY_ID= # Optional: remove or leave empty to use IAM role auth
CONTEXTUAL_ENGINE_AWS_BEDROCK_SECRET_ACCESS_KEY= # Optional: remove or leave empty to use IAM role auth
CONTEXTUAL_ENGINE_AWS_BEDROCK_REGION=

# ---- GCP Vertex (GCP_VERTEX) ----
# CONTEXTUAL_ENGINE_GCP_VERTEX_PROJECT_ID=
# CONTEXTUAL_ENGINE_GCP_VERTEX_LOCATION=
# CONTEXTUAL_ENGINE_GCP_VERTEX_MODEL_ID=
# CONTEXTUAL_ENGINE_GCP_VERTEX_CREDENTIALS_JSON=

# ---- Anthropic (ANTHROPIC) ----
# CONTEXTUAL_ENGINE_ANTHROPIC_API_KEY=
# CONTEXTUAL_ENGINE_ANTHROPIC_MODEL=

# ---- Mistral (MISTRAL) ----
# CONTEXTUAL_ENGINE_MISTRAL_API_KEY=
# CONTEXTUAL_ENGINE_MISTRAL_MODEL=

# ---- Model Parameters ----
CONTEXTUAL_ENGINE_TEMPERATURE=

# =====================================================
# CLEANING ASSISTANT LLM CONFIGURATION
# =====================================================
CLEANING_ASSISTANT_LLM_PROVIDER=

# ---- Azure OpenAI (AZURE_OPENAI) ----
CLEANING_ASSISTANT_AZURE_OPENAI_API_KEY=
CLEANING_ASSISTANT_AZURE_OPENAI_ENDPOINT=
CLEANING_ASSISTANT_AZURE_OPENAI_API_VERSION=
CLEANING_ASSISTANT_AZURE_OPENAI_DEPLOYMENT_NAME=

# ---- Azure AI Foundry (AZURE_FOUNDRY) ----
# CLEANING_ASSISTANT_AZURE_FOUNDRY_ENDPOINT=
# CLEANING_ASSISTANT_AZURE_FOUNDRY_MODEL=
# CLEANING_ASSISTANT_AZURE_FOUNDRY_API_KEY=

# ---- OpenAI (OPENAI) ----
# CLEANING_ASSISTANT_OPENAI_API_KEY=
# CLEANING_ASSISTANT_OPENAI_MODEL=

# ---- AWS Bedrock (AWS_BEDROCK) ----
CLEANING_ASSISTANT_AWS_BEDROCK_MODEL_ID=
CLEANING_ASSISTANT_AWS_BEDROCK_ACCESS_KEY_ID= # Optional: remove or leave empty to use IAM role auth
CLEANING_ASSISTANT_AWS_BEDROCK_SECRET_ACCESS_KEY= # Optional: remove or leave empty to use IAM role auth
CLEANING_ASSISTANT_AWS_BEDROCK_REGION=

# ---- GCP Vertex (GCP_VERTEX) ----
# CLEANING_ASSISTANT_GCP_VERTEX_PROJECT_ID=
# CLEANING_ASSISTANT_GCP_VERTEX_LOCATION=
# CLEANING_ASSISTANT_GCP_VERTEX_MODEL_ID=
# CLEANING_ASSISTANT_GCP_VERTEX_CREDENTIALS_JSON=

# ---- Anthropic (ANTHROPIC) ----
# CLEANING_ASSISTANT_ANTHROPIC_API_KEY=
# CLEANING_ASSISTANT_ANTHROPIC_MODEL=

# ---- Mistral (MISTRAL) ----
# CLEANING_ASSISTANT_MISTRAL_API_KEY=
# CLEANING_ASSISTANT_MISTRAL_MODEL=

# ---- Model Parameters ----
CLEANING_ASSISTANT_TEMPERATURE=

# =====================================================
# TEXT-TO-JS LLM CONFIGURATION
# =====================================================
TEXT_TO_JS_LLM_PROVIDER=

# ---- Azure OpenAI (AZURE_OPENAI) ----
TEXT_TO_JS_AZURE_OPENAI_API_KEY=
TEXT_TO_JS_AZURE_OPENAI_ENDPOINT=
TEXT_TO_JS_AZURE_OPENAI_API_VERSION=
TEXT_TO_JS_AZURE_OPENAI_DEPLOYMENT_NAME=

# ---- Azure AI Foundry (AZURE_FOUNDRY) ----
# TEXT_TO_JS_AZURE_FOUNDRY_ENDPOINT=
# TEXT_TO_JS_AZURE_FOUNDRY_MODEL=
# TEXT_TO_JS_AZURE_FOUNDRY_API_KEY=

# ---- OpenAI (OPENAI) ----
# TEXT_TO_JS_OPENAI_API_KEY=
# TEXT_TO_JS_OPENAI_MODEL=

# ---- AWS Bedrock (AWS_BEDROCK) ----
TEXT_TO_JS_AWS_BEDROCK_MODEL_ID=
TEXT_TO_JS_AWS_BEDROCK_ACCESS_KEY_ID= # Optional: remove or leave empty to use IAM role auth
TEXT_TO_JS_AWS_BEDROCK_SECRET_ACCESS_KEY= # Optional: remove or leave empty to use IAM role auth
TEXT_TO_JS_AWS_BEDROCK_REGION=

# ---- GCP Vertex (GCP_VERTEX) ----
# TEXT_TO_JS_GCP_VERTEX_PROJECT_ID=
# TEXT_TO_JS_GCP_VERTEX_LOCATION=
# TEXT_TO_JS_GCP_VERTEX_MODEL_ID=
# TEXT_TO_JS_GCP_VERTEX_CREDENTIALS_JSON=

# ---- Anthropic (ANTHROPIC) ----
# TEXT_TO_JS_ANTHROPIC_API_KEY=
# TEXT_TO_JS_ANTHROPIC_MODEL=

# ---- Mistral (MISTRAL) ----
# TEXT_TO_JS_MISTRAL_API_KEY=
# TEXT_TO_JS_MISTRAL_MODEL=

# ---- Model Parameters ----
TEXT_TO_JS_TEMPERATURE=
